# ── SolarTwin Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values before starting the servers.

# ── Site Location (live_server.py — open-meteo weather fetch) ───────────────
# Used to fetch real-time irradiance and temperature from the open-meteo API.
# Default: RNSIT College, Bangalore, India
SITE_LAT=12.9007
SITE_LON=77.5174

# ── EMT Solver Server (main.py) ──────────────────────────────────────────────
# Port for the FastAPI physics solver (power_solver.py).
# Next.js proxies to this via /api/simulation/run
EMT_PORT=8001
EMT_HOST=127.0.0.1

# ── LSTM Live Server (live_server.py) ────────────────────────────────────────
# Port for the LSTM prediction + weather server.
# Next.js proxies to this via /api/live
LIVE_PORT=8000
LIVE_HOST=0.0.0.0

# ── Optional: Calibrated LSTM ─────────────────────────────────────────────────
# Set to 1 to load CalibratedLSTM (fine-tuned on real sensor data).
# Requires lstm_calibration.pth to exist in the repo root.
# When 0 (default), loads the standard MATLAB-trained LSTMModel.
USE_CALIBRATED_LSTM=0
